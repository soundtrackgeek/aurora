{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora",
  "version": "0.20.1",
  "identifier": "com.soundtrackgeek.aurora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurora",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "maximized": false,
        "backgroundColor": "#05080d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost http://aurora-cover.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RDgzRTVGMjJCOTZGNzYKUldSMmI3a2lYejdZU0pVT3Y0ZnZ3cGZpUmRWaEVUU0tJb25hZFZRVDhvenh1U1dXblhOMjdtSEE=",
      "endpoints": [
        "https://github.com/soundtrackgeek/aurora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
